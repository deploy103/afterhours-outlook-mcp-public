# Non-secret config. Replace UUIDs before OAuth connect; zeros permit disconnected smoke startup.
OUTLOOK_TENANT_ID=00000000-0000-0000-0000-000000000000
OUTLOOK_CLIENT_ID=00000000-0000-0000-0000-000000000000
OUTLOOK_OWNER_OBJECT_ID=00000000-0000-0000-0000-000000000000
OUTLOOK_PUBLIC_ORIGIN=https://mcp.example.com
OUTLOOK_STATE_DIRECTORY=/var/lib/afterhours-outlook-mcp
# Optional, not an authorization check:
# OUTLOOK_LOGIN_HINT=owner@example.invalid
